# Zerodha Kite Connect credentials (optional)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Telegram alerts (optional)
# Create bot via @BotFather — users subscribe in the app sidebar (no chat ID needed).
TELEGRAM_BOT_TOKEN=
# Legacy: optional fixed chat ID if you prefer .env over in-app subscribe
TELEGRAM_CHAT_ID=

# Optional: path to Zerodha holdings CSV for morning briefing (else uses Kite API)
HOLDINGS_CSV=
