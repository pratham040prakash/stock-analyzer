{
  "name": "apex-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/migration-checklist.mjs --verify && npx --yes tsx scripts/validate-capital.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node scripts/apply-supabase-sql.mjs",
    "db:migrate:checklist": "node scripts/migration-checklist.mjs",
    "db:migrate:verify": "node scripts/migration-checklist.mjs --verify",
    "db:migrate:all": "node scripts/migration-checklist.mjs --apply",
    "verify:prod": "npx --yes tsx scripts/verify-prod.ts",
    "verify:deploy": "npx --yes tsx scripts/verify-deploy-services.ts",
    "verify:deploy:strict": "APEX_DEPLOY_VERIFY_STRICT=1 npx --yes tsx scripts/verify-deploy-services.ts",
    "rc:checklist": "node scripts/rc-checklist.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "axios": "^1.19.0",
    "https-proxy-agent": "^7.0.6",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postgres": "^3.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
