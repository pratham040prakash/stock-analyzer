# Public (browser + OAuth redirects)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server only
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ZERODHA_API_KEY=your_kite_connect_api_key
ZERODHA_API_SECRET=your_kite_connect_api_secret
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key
CRON_SECRET=your_random_cron_secret

# Kite order placement (static IP) — Fly.io CONNECT proxy (~$2/mo dedicated IPv4)
# See apex-ui/infra/kite-order-proxy/README.md
# KITE_ORDER_PROXY_URL=http://apex:your_proxy_password@YOUR_FLY_IP:3128

# Alpha AI remote worker (see apex-ui/infra/alpha-ai-worker/README.md)
# ALPHA_AI_SERVICE_URL=https://your-alpha-worker.example.com

# Optional review digest (requires APEX_REVIEW_DIGEST_ENABLED=true)
# APEX_REVIEW_DIGEST_ENABLED=false
# APEX_REVIEW_DIGEST_CHANNEL=telegram
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# APEX_DIGEST_WEBHOOK_URL=https://your-email-or-slack-webhook

# Optional prod verification (scripts/verify-prod.ts)
# APEX_VERIFY_BASE_URL=https://your-app.vercel.app
# APEX_VERIFY_COOKIE=sb-access-token=...; sb-refresh-token=...
# APEX_E2E_COOKIE=sb-access-token=...; sb-refresh-token=...

# Auto-trade is off by default (constitution). Set true only for controlled ops testing.
# APEX_AUTO_TRADE_ENABLED=false
# APEX_PREMIUM_ALLOW_ALL=true
# APEX_PREMIUM_USER_IDS=comma-separated-supabase-user-uuids
# APEX_PREMIUM_ACCESS_CODES=comma-separated-invite-codes-for-beta-activation

# Razorpay subscriptions (T3-2 — set APEX_RAZORPAY_ENABLED=true when ready)
# APEX_RAZORPAY_ENABLED=false
# RAZORPAY_KEY_ID=rzp_live_or_test_key
# RAZORPAY_KEY_SECRET=your_razorpay_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# RAZORPAY_PLAN_ID_MONTHLY=plan_xxx
# RAZORPAY_PLAN_ID_YEARLY=plan_yyy
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_or_test_key
# Webhook URL: https://your-app.vercel.app/api/subscription/webhook/razorpay

# Premium trial after first Wait receipt (T3-3 — enabled by default)
# APEX_PREMIUM_TRIAL_ENABLED=false
# APEX_PREMIUM_TRIAL_DAYS=7
# APEX_ADVISOR_PILOT_ENABLED=true
# APEX_ADVISOR_PILOT_SEATS=1
# APEX_SPOUSE_REVIEW_INVITE_ENABLED=false
# APEX_ESOP_REVIEW_PERSONA_ENABLED=false

# Setup (Vercel + Supabase + Kite):
# 1. Set all variables above in Vercel → Project Settings → Environment Variables
# 2. Supabase Auth → URL Configuration:
#    Site URL: https://your-app.vercel.app
#    Redirect URLs (add both):
#      https://your-app.vercel.app/auth/callback
#      https://your-app.vercel.app
# 3. Kite Connect (https://developers.kite.trade/apps) → Redirect URL:
#    https://your-app.vercel.app/api/zerodha/callback
# 4. Run supabase/schema.sql in Supabase SQL editor (creates broker_connections)
#    If table exists already, run supabase/migrations/20260807_broker_connections.sql
# 5. Vercel Cron uses Authorization: Bearer ${CRON_SECRET} (see vercel.json)
