# Public (browser + OAuth redirects)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server only
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ZERODHA_API_KEY=your_kite_connect_api_key
ZERODHA_API_SECRET=your_kite_connect_api_secret
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key
CRON_SECRET=your_random_cron_secret

# Setup (Vercel + Supabase + Kite):
# 1. Set all variables above in Vercel → Project Settings → Environment Variables
# 2. Supabase Auth → URL Configuration:
#    Site URL: NEXT_PUBLIC_APP_URL
#    Redirect URLs: ${NEXT_PUBLIC_APP_URL}/auth/callback
# 3. Kite Connect → Redirect URL: ${NEXT_PUBLIC_APP_URL}/
# 4. Run supabase/schema.sql in Supabase SQL editor
# 5. Vercel Cron uses Authorization: Bearer ${CRON_SECRET} (see vercel.json)
