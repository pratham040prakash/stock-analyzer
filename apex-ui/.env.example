# Public (browser + OAuth redirects)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server only
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ZERODHA_API_KEY=your_kite_connect_api_key
ZERODHA_API_SECRET=your_kite_connect_api_secret
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key
CRON_SECRET=your_random_cron_secret

# Optional premium tier (server only)
# APEX_PREMIUM_ALLOW_ALL=true
# APEX_PREMIUM_USER_IDS=comma-separated-supabase-user-uuids
# APEX_PREMIUM_ACCESS_CODES=comma-separated-invite-codes-for-beta-activation

# Setup (Vercel + Supabase + Kite):
# 1. Set all variables above in Vercel → Project Settings → Environment Variables
# 2. Supabase Auth → URL Configuration:
#    Site URL: https://your-app.vercel.app
#    Redirect URLs (add both):
#      https://your-app.vercel.app/auth/callback
#      https://your-app.vercel.app
# 3. Kite Connect (https://developers.kite.trade/apps) → Redirect URL:
#    https://your-app.vercel.app/api/zerodha/callback
# 4. Run supabase/schema.sql in Supabase SQL editor (creates broker_connections)
#    If table exists already, run supabase/migrations/20260807_broker_connections.sql
# 5. Vercel Cron uses Authorization: Bearer ${CRON_SECRET} (see vercel.json)
